{
  "name": "bintools",
  "version": "0.0.1",
  "private": true,
  "description": "面向不会编程的实验室科研人员的桌面端生物分析可视化软件",
  "author": "Hear1t",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "build:mac": "tsc -b && vite build && electron-builder --mac --config electron-builder.config.cjs",
    "build:win": "tsc -b && vite build && electron-builder --win --config electron-builder.config.cjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/plotly.js": "^3.0.10",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.16.0",
    "ml-hclust": "^4.0.0",
    "plotly.js-dist-min": "^3.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svg2pdf.js": "^2.7.0",
    "tailwind-merge": "^3.6.0",
    "use-debounce": "^10.1.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^31.0.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
